# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=

# --- Terac (from organizers) ---
TERAC_API_KEY=
TERAC_MCP_TOKEN=
TERAC_PROJECT_ID=
# Enable only after the recruitment SQL migration and reviewer page are deployed.
TERAC_RECRUITMENT_ENABLED=false
# Enable after the feedback-quality SQL migration is applied.
FEEDBACK_REVIEW_ENABLED=false
# Maximum total USD cents per order. Also capped at $6 per selected reviewer.
TERAC_MAX_ORDER_COST_CENTS=1800
TERAC_WEBHOOK_SECRET=

# --- Whop PRODUCTION (real money) ---
WHOP_ENVIRONMENT=production
WHOP_API_KEY=
WHOP_BIZ_ID=
WHOP_WEBHOOK_SECRET=

# --- Whop SANDBOX (testing only) ---
WHOP_SANDBOX_API_KEY=
WHOP_SANDBOX_WEBHOOK_SECRET=
WHOP_SANDBOX_BIZ_ID=

# --- Supabase (server only) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Supabase (browser-safe) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- App ---
PUBLIC_BASE_URL=
DASHBOARD_PASSWORD=
CRON_SECRET=

# Optional dedicated signing key for private order sessions.
# If omitted, the server uses SUPABASE_SERVICE_KEY. Rotating either invalidates existing sessions.
ORDER_SESSION_SECRET=

# Referrals: run 2026-10-24-referrals.sql before enabling. Payouts require Whop transfer permission/funds.
REFERRALS_ENABLED=false
REFERRAL_PAYOUTS_ENABLED=false

# Signs private order links (/order/[id]?key=…), so the server can rebuild them to message buyers.
# Rotating it breaks links sent before the change.
ORDER_LINK_SECRET=
